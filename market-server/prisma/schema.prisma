// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum ContentStatus {
  ACTIVE // 판매 중
  DISCONTINUED // 절판
  BANNED // 판매 금지
}

enum RegistrationStatus {
  PENDING // 등록 요청됨
  PROCESSING // 등록 처리 중
  APPROVED // 등록 승인
  REJECTED // 등록 거절
}

enum BuyStatus {
  REQUESTED // 구매 요청 생성
  PENDING // 거래 승인 대기
  APPROVED // 최종 승인
  REJECTED // 거래 거절
}

enum OutboxJobType {
  CONTENT_REGISTRATION
  TRADE_APPROVAL
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// ============================================================
// User
// ============================================================

model User {
  id Int @id @default(autoincrement())

  // 로그인 ID
  username String @unique @db.VarChar(100)

  // 로그인/인증용 Argon2id 해시 (PHC encoded string)
  passwordHash String @map("password_hash") @db.VarChar(255)

  // 사용자의 공개키
  pkOwn String @map("pk_own") @db.VarChar(64)

  // 암호화된 공개키 (BabyJubjub point, x||y = 128 hex)
  pkEnc String @map("pk_enc") @db.VarChar(128)

  // 사용자 주소 
  addr String @unique @db.VarChar(64)

  // Ethereum EOA 
  eoa String @db.VarChar(42)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  // 이 사용자가 작성한 소설
  contents ContentList[]

  // 이 사용자가 구매한 소설
  purchases            BuyHistory[]
  // 이 사용자의 refresh token
  refreshTokens        RefreshToken[]
  contentRegistrations ContentRegistration[]

  @@map("user")
}

model ContentRegistration {
  id Int @id @default(autoincrement())

  title       String  @db.VarChar(200)
  description String  @db.Text
  authorId    Int     @map("author_id")
  price       Decimal @db.Decimal(18, 0)

  status RegistrationStatus @default(PENDING)

  rejectionReason String? @map("rejection_reason") @db.Text

  // 승인 후 실제 ContentList와 연결
  contentId Int? @unique @map("content_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author      User         @relation(fields: [authorId], references: [id])
  contentList ContentList? @relation(fields: [contentId], references: [id])

  source ContentRegistrationSource?

  @@index([authorId])
  @@index([createdAt])
  @@map("content_registrations")
}

model ContentRegistrationSource {
  id Int @id @default(autoincrement())

  registrationId Int @unique @map("registration_id")

  // ZK Proof 생성에 사용할 원문
  originalText String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  registration ContentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("content_registration_sources")
}

// ============================================================
// ContentList
// ============================================================

model ContentList {
  id Int @id @default(autoincrement())

  // 소설 제목
  title String @db.VarChar(200)

  // 작가 ID
  authorId    Int     @map("author_id")
  description String? @db.Text
  // 판매 가격
  price       Decimal @db.Decimal(18, 0)

  // ----------------------------------------------------------
  // 암호화된 소설 데이터
  // ----------------------------------------------------------
  // CT_data 를 각각 32-byte BE 로 연결 (DATA_BLOCK_NUM × 32 bytes)
  encryptedData Bytes @map("encrypted_data")

  // ----------------------------------------------------------
  // Poseidon 공개값 (canonical 32-byte BE)
  // ----------------------------------------------------------

  // h_k = Poseidon(pk_own, dataEncKey)
  hK Bytes @map("h_k")

  // h_data = Poseidon(data[0..N-1])
  hData Bytes @map("h_data")

  // h_ct = Poseidon(CT_data[0..N-1])
  hCt Bytes @map("h_ct")

  // ----------------------------------------------------------
  // Content 상태
  // ----------------------------------------------------------

  status ContentStatus @default(ACTIVE)
  txHash String @map("tx_hash")

  // ----------------------------------------------------------
  // Timestamp
  // ----------------------------------------------------------

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  // 작성자
  author User @relation(fields: [authorId], references: [id])

  purchases BuyHistory[]

  // 이 소설을 생성한 등록 요청 (승인 시 연결)
  registration ContentRegistration?

  // ----------------------------------------------------------
  // Index
  // ----------------------------------------------------------

  // 작성자별 소설 검색
  @@index([authorId])
  // 상태별 검색
  @@index([status])
  // 최신 소설 검색
  @@index([createdAt])
  @@map("content_list")
}

// ============================================================
// BuyHistory
// ============================================================

model BuyHistory {
  id Int @id @default(autoincrement())

  // 구매자 ID
  buyerId Int @map("buyer_id")

  // 구매한 소설 ID
  contentId Int @map("content_id")

  // 구매 당시 가격
  price Decimal @db.Decimal(18, 0)

  // 거래 상태
  status BuyStatus @default(REQUESTED)

  // 거래 거절 사유
  rejectionReason String? @map("rejection_reason") @db.Text

  // Ethereum transaction hash
  txHash String? @map("tx_hash") @db.VarChar(66)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyer User @relation(fields: [buyerId], references: [id])

  content ContentList @relation(fields: [contentId], references: [id])

  @@unique([buyerId, contentId])
  @@index([buyerId])
  @@index([contentId])
  @@index([status])
  @@map("buy_history")
}

// ============================================================
// RefreshToken
// ============================================================

model RefreshToken {
  id Int @id @default(autoincrement())

  // 토큰 소유자
  userId Int @map("user_id")

  // Refresh Token 원문(JWT)을 SHA-256으로 hash한 값 (hex, 64자)
  // 원문은 DB에 저장하지 않는다.
  tokenHash String @map("token_hash") @db.VarChar(64)

  // JWT의 jti (unique token id)
  jti String @unique @db.VarChar(36)

  // Rotation family id — 하나의 로그인 세션에서 발급된
  // Refresh Token들은 같은 family_id를 공유한다 (재사용 감지용)
  familyId String @map("family_id") @db.VarChar(36)

  expiresAt DateTime @map("expires_at")

  // revoke된 시각 (null이면 유효)
  revokedAt DateTime? @map("revoked_at")

  // rotation 시 이 토큰을 대체한 새 토큰의 jti
  replacedBy String? @map("replaced_by") @db.VarChar(36)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ============================================================
// Outbox
// ============================================================

model Outbox {
  id Int @id @default(autoincrement())

  // 작업 ID
  jobId String @map("job_id") @db.VarChar(100)
  jobType OutboxJobType @map("job_type")
  // 작업 대상 DB ID
  referenceId Int @map("reference_id")

  // Outbox 처리 상태
  status OutboxStatus @default(PENDING)

  // Kafka publish 성공 시각
  // null이면 아직 publish되지 않음
  publishedAt DateTime? @map("published_at")

  // publish 재시도 횟수
  retryCount Int @default(0) @map("retry_count")

  // 마지막 publish 실패 이유
  lastError String? @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 미발행 이벤트 조회
  @@index([publishedAt, createdAt])

  // jobId 조회 / idempotency
  @@index([jobId])

  // 작업 종류 + 대상 ID 조회
  @@index([jobType, referenceId])

  @@map("outbox")
}