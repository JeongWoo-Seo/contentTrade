// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum ContentStatus {
  ACTIVE // 판매 중
  DISCONTINUED // 절판
  BANNED // 판매 금지
}

enum RegistrationStatus {
  PENDING // 등록 요청됨
  PROCESSING // 등록 처리 중
  APPROVED // 등록 승인
  REJECTED // 등록 거절
}

enum BuyStatus {
  REQUESTED // 구매 요청 생성
  PENDING // 거래 승인 대기
  APPROVED // 최종 승인
  REJECTED // 거래 거절
}

// ============================================================
// User
// ============================================================

model User {
  id Int @id @default(autoincrement())

  // 로그인 ID
  username String @unique @db.VarChar(100)

  // 로그인/인증용 Argon2id 해시 (PHC encoded string)
  passwordHash String @map("password_hash") @db.VarChar(255)

  // 사용자의 공개키
  pkOwn String @map("pk_own") @db.VarChar(64)

  // 암호화된 공개키 (BabyJubjub point, x||y = 128 hex)
  pkEnc String @map("pk_enc") @db.VarChar(128)

  // 사용자 주소 
  addr String @unique @db.VarChar(64)

  // Ethereum EOA 
  eoa String @db.VarChar(42)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  // 이 사용자가 작성한 소설
  contents ContentList[]

  // 이 사용자가 구매한 소설
  purchases            BuyHistory[]
  // 이 사용자의 refresh token
  refreshTokens        RefreshToken[]
  contentRegistrations ContentRegistration[]

  @@map("user")
}

model ContentRegistration {
  id Int @id @default(autoincrement())

  title       String  @db.VarChar(200)
  description String  @db.Text
  authorId    Int     @map("author_id")
  price       Decimal @db.Decimal(18, 0)

  status RegistrationStatus @default(PENDING)

  rejectionReason String? @map("rejection_reason") @db.Text

  // 승인 후 실제 ContentList와 연결
  contentId Int? @unique @map("content_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author      User         @relation(fields: [authorId], references: [id])
  contentList ContentList? @relation(fields: [contentId], references: [id])

  source ContentRegistrationSource?

  @@index([authorId])
  @@index([createdAt])
  @@map("content_registrations")
}

model ContentRegistrationSource {
  id Int @id @default(autoincrement())

  registrationId Int @unique @map("registration_id")

  // ZK Proof 생성에 사용할 원문
  originalText String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  registration ContentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("content_registration_sources")
}

// ============================================================
// ContentList
// ============================================================

model ContentList {
  id Int @id @default(autoincrement())

  // 소설 제목
  title String @db.VarChar(200)

  // 작가 ID
  authorId    Int     @map("author_id")
  description String? @db.Text
  // 판매 가격
  price       Decimal @db.Decimal(18, 0)

  // ----------------------------------------------------------
  // 암호화된 소설 데이터
  // ----------------------------------------------------------

  // AES-256-GCM으로 암호화된 소설
  // Base64 문자열
  encryptedData String @map("encrypted_data") @db.Text

  // AES-GCM IV / Nonce
  // 12 bytes → Base64
  iv String @db.VarChar(255)

  // AES-GCM Authentication Tag
  // 16 bytes → Base64
  authTag String @map("auth_tag") @db.VarChar(255)

  // ----------------------------------------------------------
  // Data Key
  // ----------------------------------------------------------

  // 소설 암호화에 사용된 AES Data Key를
  // MASTER_KEY로 암호화한 값
  encryptedDataKey String @map("encrypted_data_key") @db.Text

  // ----------------------------------------------------------
  // 암호화 버전
  // ----------------------------------------------------------

  // 나중에 암호화 알고리즘이나 키 구조가 변경될 경우 사용
  encryptionVersion Int @default(1) @map("encryption_version")

  // ----------------------------------------------------------
  // Content 검증
  // ----------------------------------------------------------

  // 원문 검증용 SHA-256 hash
  // SHA-256을 HEX로 저장하면 64자
  contentHash String @map("content_hash") @db.VarChar(64)

  // ----------------------------------------------------------
  // Content 상태
  // ----------------------------------------------------------

  status ContentStatus @default(ACTIVE)
  txHash String @map("tx_hash")

  // ----------------------------------------------------------
  // Timestamp
  // ----------------------------------------------------------

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ----------------------------------------------------------
  // Relations
  // ----------------------------------------------------------

  // 작성자
  author User @relation(fields: [authorId], references: [id])

  purchases BuyHistory[]

  // 이 소설을 생성한 등록 요청 (승인 시 연결)
  registration ContentRegistration?

  // ----------------------------------------------------------
  // Index
  // ----------------------------------------------------------

  // 작성자별 소설 검색
  @@index([authorId])
  // 상태별 검색
  @@index([status])
  // 최신 소설 검색
  @@index([createdAt])
  @@map("content_list")
}

// ============================================================
// BuyHistory
// ============================================================

model BuyHistory {
  id Int @id @default(autoincrement())

  // 구매자 ID
  buyerId Int @map("buyer_id")

  // 구매한 소설 ID
  contentId Int @map("content_id")

  // 구매 당시 가격
  price Decimal @db.Decimal(18, 0)

  // 거래 상태
  status BuyStatus @default(REQUESTED)

  // 거래 거절 사유
  rejectionReason String? @map("rejection_reason") @db.Text

  // Ethereum transaction hash
  txHash String? @map("tx_hash") @db.VarChar(66)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyer User @relation(fields: [buyerId], references: [id])

  content ContentList @relation(fields: [contentId], references: [id])

  @@unique([buyerId, contentId])
  @@index([buyerId])
  @@index([contentId])
  @@index([status])
  @@map("buy_history")
}

// ============================================================
// RefreshToken
// ============================================================

model RefreshToken {
  id Int @id @default(autoincrement())

  // 토큰 소유자
  userId Int @map("user_id")

  // Refresh Token 원문(JWT)을 SHA-256으로 hash한 값 (hex, 64자)
  // 원문은 DB에 저장하지 않는다.
  tokenHash String @map("token_hash") @db.VarChar(64)

  // JWT의 jti (unique token id)
  jti String @unique @db.VarChar(36)

  // Rotation family id — 하나의 로그인 세션에서 발급된
  // Refresh Token들은 같은 family_id를 공유한다 (재사용 감지용)
  familyId String @map("family_id") @db.VarChar(36)

  expiresAt DateTime @map("expires_at")

  // revoke된 시각 (null이면 유효)
  revokedAt DateTime? @map("revoked_at")

  // rotation 시 이 토큰을 대체한 새 토큰의 jti
  replacedBy String? @map("replaced_by") @db.VarChar(36)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
