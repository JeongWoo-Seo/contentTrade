# Copy to .env and fill in real values. Do NOT commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# JWT (generate a secure random secret, e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_ISSUER=market-server
JWT_AUDIENCE=market-client
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# Refresh cookie: set true in production (HTTPS), false for local http dev.
COOKIE_SECURE=false

# Comma-separated list of allowed CORS origins (credentials enabled).
CORS_ORIGIN=http://localhost:5173
